{
  "compilerOptions": {
    "target": "ES2020",
    "module": "nodenext",
    "moduleResolution": "nodenext",

    "rootDir": "./src",
    // "noEmit": true,
    "outDir": "./dist",

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "assumeChangesOnlyAffectDirectDependencies": true,
    "allowArbitraryExtensions": true,  // Add this
    // "allowImportingTsExtensions": true,
    

    "types": ["node"],

    "incremental": false,
    // "composite": true
  },

  "include": ["src/**/*.ts"],

  "exclude": [
    "node_modules",
    "dist",
    ".turbo",
  ]
    
}

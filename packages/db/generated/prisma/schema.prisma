// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SIDE {
  BUY
  SELL
}

enum TYPE {
  LIMIT
  MARKET
}

enum STATUS {
  PENDING
  FULL_FILLED
  PARTIALLY_FILLED
  CANCELLED
}

enum LedgerType {
  CREDIT
  DEBIT
}

enum LedgerReason {
  TRADE_PROFIT
  TRADE_COST
  ASSET_CREDIT
  ASSET_DEBIT
  FEE
  DEPOSIT
  WITHDRAWAL
}

model Orders {
  orderId         String   @unique
  symbol          String
  userId          String
  side            SIDE
  type            TYPE
  quote_price     Float
  quote_quantity  Float
  filled_quantity Float    @default(0)
  filled_price    Float    @default(-1)
  timestamp       DateTime
  updatedAt       DateTime
  status          STATUS
}

model Trades {
  tradeId   String
  symbol    String
  price     Float
  volume    Float
  timestamp DateTime

  @@id([timestamp, symbol])
  @@unique([tradeId, timestamp])
  @@unique([symbol, timestamp])
  @@index([timestamp])
}

model User {
  userId       String     @unique @default(uuid())
  name         String
  email        String     @unique
  password     String
  pin          String
  balance      Balances[]
  transactions Ledger[]
}

model Balances {
  balanceId     String   @unique @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [userId])
  asset         String
  freeBalance   BigInt   @default(0)
  lockedBalance BigInt   @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  ledgers       Ledger[]

  @@unique([userId, asset])
}

model Ledger {
  ledgerId  String       @id @default(uuid())
  balanceId String
  user      User         @relation(fields: [userId], references: [userId])
  userId    String
  balance   Balances     @relation(fields: [balanceId], references: [balanceId])
  type      LedgerType
  symbol    String
  createdAt DateTime     @default(now())
  amount    BigInt
  reason    LedgerReason
}

model Tickers {
  tickerId String @id @default(uuid())
  symbol   String
}

model Symbol {
  symbolId Int     @id @default(autoincrement())
  name     String
  img      String
  code     String?
}

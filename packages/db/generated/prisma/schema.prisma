// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SIDE {
  BUY
  SELL
}

enum TYPE {
  LIMIT
  MARKET
}

enum STATUS {
  PENDING
  FULL_FILLED
  PARTIALLY_FILLED
  CANCELLED
}

enum LedgerType {
  CREDIT
  DEBIT
}

model Orders {
  orderId         String   @unique
  symbol          String
  userId          String
  side            SIDE
  type            TYPE
  quote_price     Float
  quote_quantity  Float
  filled_quantity Float    @default(0)
  filled_price    Float    @default(-1)
  timestamp       DateTime
  updatedAt       DateTime
  status          STATUS
}

model Trades {
  tradeId   String
  symbol    String
  price     Float
  volume    Float
  timestamp DateTime

  @@id([timestamp, symbol])
  @@unique([tradeId, timestamp])
  @@unique([symbol, timestamp])
}

model User {
  userId   String  @unique @default(uuid())
  email    String  @unique
  password String
  pin      String
  wallet   Wallet?
}

model Wallet {
  walletId      String   @unique @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [userId])
  freeBalance   BigInt   @default(0)
  lockedBalance BigInt   @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  ledgers       Ledger[]
}

model Ledger {
  ledgerId  String     @id @default(uuid())
  walletId  String
  wallet    Wallet     @relation(fields: [walletId], references: [walletId])
  type      LedgerType
  reason    String
  createdAt DateTime   @default(now())
  amount    BigInt
}
